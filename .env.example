# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除；本文件是模板，需要提交到 git。

# --- LLM（任何 OpenAI 兼容服务）---
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# --- 数据库 ---
# 留空则使用内存存储（重启丢失）。持久化二选一：
#   本地文件：sqlite+aiosqlite:///aoki.db
#   Postgres：postgresql://aoki:aoki@localhost:5432/aoki（托管平台给的 postgres:// 连接串可直接用）
DATABASE_URL=

# --- 公网访问 ---
# 访问码。留空 = 不设门槛（本地开发）；部署到公网必须设，用一串够长的随机字符
ACCESS_CODE=
# 线上走 HTTPS 时设为 true（cookie 只经 HTTPS 发送）；本地 http 保持 false
COOKIE_SECURE=false

# --- Langfuse（留空则不追踪）---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 必须与项目所在区域一致，否则 401：
#   EU https://cloud.langfuse.com   US https://us.cloud.langfuse.com   JP https://jp.cloud.langfuse.com
LANGFUSE_HOST=https://jp.cloud.langfuse.com

# --- Agent ---
MAX_ITERATIONS=8
